{
  // Tools4Market — Cloudflare Workers Static Assets + Worker backend.
  // Deploys the built site in dist/ and the /api/fetch proxy (worker.js) from one project.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools4market",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  // Workers AI binding — powers POST /api/suggest (AI fix suggestions).
  // The model call stays server-side; no API key exists anywhere.
  "ai": { "binding": "AI" },
  "routes": [
    { "pattern": "www.tools4market.online/*", "zone_name": "tools4market.online" }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Run the Worker first for every request so the Worker can enforce the
    // one-hop canonical redirect (www -> apex) and serve /api/fetch.
    // Without this, Workers serves matching files straight from the asset
    // store and the Worker (and the redirect) never runs.
    "run_worker_first": true,
    // /tools/slug/ → /tools/slug/index.html. A no-slash directory URL would get a
    // 307 from this layer (Cloudflare's documented html_handling behaviour), so
    // worker.js answers 301 before assets ever see it — see the trailing-slash
    // block there. Keep this setting: it is what maps the slash form to index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
