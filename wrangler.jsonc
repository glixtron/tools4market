{
  // Tools4Market — Cloudflare Workers Static Assets + Worker backend.
  // Deploys the built site in dist/ and the /api/fetch proxy (worker.js) from one project.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools4market",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Run the Worker first for every request so the Worker can enforce the
    // one-hop canonical redirect (www -> apex) and serve /api/fetch.
    // Without this, Workers serves matching files straight from the asset
    // store and the Worker (and the redirect) never runs.
    "run_worker_first": true,
    // /tools/slug/ → /tools/slug/index.html, and /tools/slug → 301 to the slash form
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
