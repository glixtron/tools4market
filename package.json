{
  "name": "tools4market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tools4Market — free browser-based marketing, SEO & AI-search tools",
  "scripts": {
    "build": "node build.mjs",
    "postinstall": "node build.mjs || true",
    "serve": "node serve-dev.mjs",
    "deploy": "node build.mjs && node scripts/check-deploy.mjs && npx wrangler deploy",
    "preview": "npx wrangler dev",
    "test": "node tests/smoke.mjs",
    "test:tools": "node tests/tools-behaviour.mjs",
    "test:seo": "node tests/seo-audit.mjs",
    "test:consent": "node tests/consent-test.mjs",
    "test:worker": "node tests/worker-routing.mjs",
    "test:links": "node tests/local-links.mjs",
    "test:live": "node tests/live-verify.mjs",
    "test:audit": "node audit/tests/rules.test.mjs",
    "test:audit-api": "node tests/audit-batch-test.mjs",
    "audit": "node audit/pipeline.mjs",
    "audit:dist": "node audit/pipeline.mjs --dist",
    "audit:strict": "node audit/pipeline.mjs --strict",
    "check:sources": "node scripts/check-sources.mjs",
    "check:social": "node scripts/check-social.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "brand:og": "node scripts/render-og.mjs"
  }
}
